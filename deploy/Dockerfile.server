# The API as a long-running server.
#
# The Lambda image cannot serve this: the account's organisation forbids both
# public function URLs and CloudFront's service principal from invoking one, so
# the same application runs as an ordinary HTTP server behind CloudFront
# instead. Only the entrypoint differs — the model, the API and the page are the
# same files.
FROM python:3.12-slim

WORKDIR /srv

COPY deploy/requirements-lambda.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir boto3

COPY applebee/ ./applebee/
COPY web/ ./web/
COPY deploy/regions.aws.json ./regions.aws.json

# The two evaluations read four files directly rather than through the region
# registry: the New York orchard observations, that region's weather and forage
# index, and the Pennsylvania monitoring counts. 2.8 MB, tracked in git, and
# needed on every /api/evaluate — so they travel in the image. Everything large
# stays in S3 and is read in byte ranges.
COPY data/inputs/observations/ ./data/inputs/observations/
COPY data/inputs/weather/new_york/ ./data/inputs/weather/new_york/
COPY data/inputs/forage/ny_forage_spring_2015_sites.csv ./data/inputs/forage/

ENV PYTHONUNBUFFERED=1 APPLEBEE_REGIONS=/srv/regions.aws.json
EXPOSE 8000

# Reads its weather from S3 in byte ranges, so the image carries no inputs and
# the disk under it stays small.
CMD ["python", "-m", "web.app", "--port", "8000", "--host", "0.0.0.0"]
